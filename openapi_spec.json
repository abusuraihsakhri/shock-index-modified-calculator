{
  "openapi": "3.1.0",
  "info": {
    "title": "Shock Index Modified Calculator API",
    "version": "1.0.0",
    "description": "Research and educational numerical calculator; separate illustrative audit demo. Runtime /openapi.json is authoritative."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service status (JSON)"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory demo counters (JSON, not Prometheus text)",
        "responses": {
          "200": {
            "description": "Current in-memory counters"
          }
        }
      }
    },
    "/api/calculate": {
      "post": {
        "summary": "Calculate SI, MSI, MAP, Age-SI and reverse SI",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "hr",
                  "sbp"
                ],
                "properties": {
                  "hr": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Heart rate, bpm"
                  },
                  "sbp": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Systolic BP, mmHg"
                  },
                  "dbp": {
                    "type": "number",
                    "minimum": 0,
                    "description": "Optional diastolic BP, must not exceed SBP"
                  },
                  "age": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "description": "Optional age, years"
                  },
                  "sex": {
                    "type": "string",
                    "description": "Optional metadata"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated indices and exploratory interpretation"
          },
          "422": {
            "description": "Input validation error"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Process generic demonstration task",
        "responses": {
          "200": {
            "description": "In-memory demonstration dossier"
          },
          "422": {
            "description": "Invalid payload"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Query deterministic mock (not clinical reasoning)",
        "responses": {
          "200": {
            "description": "Mock demonstration response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read HMAC-protected in-process audit chain",
        "responses": {
          "200": {
            "description": "Audit entries and signature validation result"
          }
        }
      }
    }
  }
}
